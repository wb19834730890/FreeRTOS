{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "Debug"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug", "-j", "8"],
      "dependsOn": ["Configure (Debug)"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "Configure (Release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "Release"],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "Build (Release)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Release", "-j", "8"],
      "dependsOn": ["Configure (Release)"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "Debug", "--target", "clean"],
      "problemMatcher": []
    }
  ]
}
